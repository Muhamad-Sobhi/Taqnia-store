# Local-only values for docker-compose.hosting-simulation.yml.
# Copy to .env.local for host-side Drizzle commands.
MARIADB_IMAGE=mariadb:11.4
MARIADB_HOST_PORT=3307
NODE_IMAGE=node:24-bookworm-slim

NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:3310
PORT=3000

# Loopback host and disposable database port.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_NAME=taqnia_store_hosting_local
DATABASE_USER=taqnia_simulation
DATABASE_PASSWORD=local-only-simulation-password
DATABASE_CONNECTION_LIMIT=3

SESSION_SECRET=local-only-simulation-secret-at-least-32-characters
ANALYTICS_ENABLED=false
