# Copy to .env for local use. Never commit .env files.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PORT=3000

# Use a dedicated local MySQL database; never point local commands at production.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=taqnia_store_local
DATABASE_USER=taqnia_store_user
DATABASE_PASSWORD=replace-with-a-local-secret
DATABASE_CONNECTION_LIMIT=3

# Generate a random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Analytics stays disabled in version 1.
ANALYTICS_ENABLED=false
