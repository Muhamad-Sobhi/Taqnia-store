{
  "name": "taqnia-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
    "db:hosting-smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/hosting-database-smoke.ts",
    "db:admin:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-local-admin.ts",
    "hosting:simulation:up": "docker compose --env-file .env.hosting-simulation.example -f docker-compose.hosting-simulation.yml up -d mariadb",
    "hosting:simulation:app": "docker compose --env-file .env.hosting-simulation.example -f docker-compose.hosting-simulation.yml up --build -d app",
    "hosting:simulation:status": "docker compose --env-file .env.hosting-simulation.example -f docker-compose.hosting-simulation.yml ps",
    "hosting:simulation:down": "docker compose --env-file .env.hosting-simulation.example -f docker-compose.hosting-simulation.yml down",
    "hosting:compat:106:up": "MARIADB_IMAGE=mariadb:10.6 MARIADB_HOST_PORT=3308 docker compose --env-file .env.hosting-simulation.example -p taqnia-store-mariadb106 -f docker-compose.hosting-simulation.yml up -d mariadb",
    "hosting:compat:106:down": "MARIADB_IMAGE=mariadb:10.6 MARIADB_HOST_PORT=3308 docker compose --env-file .env.hosting-simulation.example -p taqnia-store-mariadb106 -f docker-compose.hosting-simulation.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "if [ -x node_modules/.bin/husky ] && [ -d ../../.git ]; then (cd ../.. && apps/store/node_modules/.bin/husky apps/store/.husky); fi"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
